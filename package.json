{
  "name": "opencode-search-plugin",
  "version": "1.0.0",
  "description": "Nine self-contained websearch provider plugins for OpenCode v2: AnySearch, Brave, Jina, Linkup, Metaso, Querit, SerpApi, Serper and You.com.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "websearch",
    "search",
    "serp",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guotree/opencode-search-plugin.git"
  },
  "homepage": "https://github.com/guotree/opencode-search-plugin#readme",
  "bugs": {
    "url": "https://github.com/guotree/opencode-search-plugin/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./anysearch-search": "./plugins/anysearch-search.ts",
    "./brave-search": "./plugins/brave-search.ts",
    "./jina-search": "./plugins/jina-search.ts",
    "./linkup-search": "./plugins/linkup-search.ts",
    "./metaso-search": "./plugins/metaso-search.ts",
    "./querit-search": "./plugins/querit-search.ts",
    "./serpapi-search": "./plugins/serpapi-search.ts",
    "./serper-search": "./plugins/serper-search.ts",
    "./youcom-search": "./plugins/youcom-search.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins",
    "index.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.30",
    "effect": "4.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
